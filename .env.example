# PostgreSQL (مطابق با docker-compose.yml)
POSTGRES_USER=noroset
POSTGRES_PASSWORD=noroset
POSTGRES_DB=noroset
POSTGRES_MIGRATOR_PASSWORD=noroset_migrator_password
POSTGRES_APP_PASSWORD=noroset_app_password

# App connection (noroset_app — subject to RLS)
DATABASE_URL=postgresql://noroset_app:noroset_app_password@localhost:5433/noroset

# Migrator connection (noroset_migrator — owner, runs migrations)
DATABASE_URL_MIGRATOR=postgresql://noroset_migrator:noroset_migrator_password@localhost:5433/noroset

# API
PORT=3001
WEB_ORIGIN=http://localhost:3000
# مرورگر API را از مسیر /api وب (Next rewrite) می‌بیند؛ مسیر cookie رفرش با همین پیشوند ست می‌شود.
API_BASE_PATH=/api
# اعتماد به X-Forwarded-For فقط از proxy مطمئن (اینجا Next روی همین ماشین). در production با
# توپولوژی واقعی تنظیم شود (تعداد hop یا IP/CIDR)؛ خالی = اعتماد نکن.
TRUST_PROXY=loopback

# Web (Next) — مقصد rewrite /api/*
API_ORIGIN=http://localhost:3001
# دامنه‌ی کوتاه صفحه‌های عمومی (production: n8l.ir)؛ docs/routes.md بخش ۳
PUBLIC_HOST=n8l.localhost
# دامنه‌ی خروجی عمومی نوروفرم و لینک پاسخ‌ها (production: n8f.ir)
NOROFORM_PUBLIC_HOST=n8f.localhost

# norofile — تنها سرویس فایل پلتفرم (S3-compatible، bucket خصوصی). development: سرویس storage در
# docker-compose. production: endpoint/کلیدهای S3 واقعی و S3_CREATE_BUCKET خالی.
# مرورگر هرگز مستقیم از bucket نمی‌خواند؛ فایل‌های public از {WEB_ORIGIN}{API_BASE_PATH}/norofile/public/files/{id}
# سرو می‌شوند. NOROFILE_PUBLIC_URL (اختیاری) همین پیشوند را جایگزین می‌کند (مثلاً CDN جلوی همین مسیر).
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=noroset-files
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_CREATE_BUCKET=true
NOROFILE_PUBLIC_URL=

# پیامک OTP (ملی‌پیامک، پترن تأییدشده از API کنسول). خارج از production پیش‌فرض console است.
# production: SMS_PROVIDER=melipayamak و هر دو مقدار زیر لازم است، وگرنه API بالا نمی‌آید.
SMS_PROVIDER=console
MELIPAYAMAK_TOKEN=
MELIPAYAMAK_OTP_BODY_ID=

# نوروفرم تا لانچ خاموش است: production مگر با true، development مگر با false (docs/routes.md).
NOROFORM_ENABLED=

# Auth
# هر secret فقط برای یک کار: JWT_SECRET امضای access token — OTP_PEPPER HMAC کد OTP —
# IP_HASH_SECRET هش IP پاسخ‌های فرم عمومی.
# در production همه باید تصادفی و دست‌کم ۳۲ کاراکتر باشند (مثلاً openssl rand -base64 48)،
# وگرنه API هنگام بوت بالا نمی‌آید.
JWT_SECRET=change-me-in-production
OTP_PEPPER=change-me-in-production
IP_HASH_SECRET=change-me-in-production
# کلید امضای نشست کوتاه‌عمر مشاهده‌ی پاسخ (OTP/کلید)؛ در production تصادفی و ۳۲+ نویسه.
RESPONSE_SESSION_SECRET=change-me-in-production


# پرداخت (docs/architecture.md §9.11). خارج از production پیش‌فرض درگاه ساختگی است (بدون پول، بازگشت فوری).
# production: PAYMENT_GATEWAY=zarinpal و ZARINPAL_MERCHANT_ID لازم است (درگاه ساختگی و ZARINPAL_SANDBOX=true رد می‌شوند).
# بازگشت درگاه به {WEB_ORIGIN}{API_BASE_PATH}/billing/callback است.
PAYMENT_GATEWAY=fake
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true
