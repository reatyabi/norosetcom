# قالب /srv/noroset/shared/.env (دسترسی 600). هر مقدار CHANGE با `openssl rand -hex 32` ساخته شود؛
# رمزهای Postgres و S3 حتماً hex باشند تا در آدرس اتصال و sed مشکل نسازند.

# PostgreSQL
POSTGRES_USER=noroset
POSTGRES_PASSWORD=CHANGE
POSTGRES_DB=noroset
POSTGRES_MIGRATOR_PASSWORD=CHANGE_MIGRATOR
POSTGRES_APP_PASSWORD=CHANGE_APP
DATABASE_URL=postgresql://noroset_app:CHANGE_APP@127.0.0.1:5433/noroset
DATABASE_URL_MIGRATOR=postgresql://noroset_migrator:CHANGE_MIGRATOR@127.0.0.1:5433/noroset

# نشانی‌ها
WEB_ORIGIN=https://noroset.com
API_BASE_PATH=/api
TRUST_PROXY=loopback
API_ORIGIN=http://127.0.0.1:3001
PUBLIC_HOST=n8l.ir
NOROFORM_PUBLIC_HOST=n8f.ir

# نوروفرم در لانچ نیست.
NOROFORM_ENABLED=false

# SeaweedFS روی همین سرور
S3_ENDPOINT=http://127.0.0.1:8333
S3_REGION=us-east-1
S3_BUCKET=noroset-files
S3_ACCESS_KEY_ID=CHANGE
S3_SECRET_ACCESS_KEY=CHANGE
S3_CREATE_BUCKET=true
NOROFILE_PUBLIC_URL=

# Secretهای برنامه؛ هر کدام جدا
JWT_SECRET=CHANGE
OTP_PEPPER=CHANGE
IP_HASH_SECRET=CHANGE
RESPONSE_SESSION_SECRET=CHANGE

# پیامک
SMS_PROVIDER=melipayamak
# توکن API کنسول ملی‌پیامک؛ بخش آخر آدرس API.
MELIPAYAMAK_TOKEN=
MELIPAYAMAK_OTP_BODY_ID=454153

# پرداخت؛ ZARINPAL_SANDBOX=true در production مانع بوت می‌شود.
PAYMENT_GATEWAY=zarinpal
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=false

# هشدار سرور با پیامک: متن تأییدشده با یک متغیر و شماره‌ی گیرنده
MELIPAYAMAK_ALERT_BODY_ID=574542
# شماره‌ی مالک؛ فقط روی سرور وارد شود و در ریپو نیاید.
ALERT_MOBILE=
